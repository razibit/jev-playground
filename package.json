{
  "name": "jev-playground",
  "version": "1.0.0",
  "description": "A Jev playground powered by Vercel AI Gateway",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -s first \"node server.js\" \"vite --host 127.0.0.1\"",
    "jev:example": "tsx index.ts",
    "jev:setup-and-run": "powershell -NoProfile -ExecutionPolicy Bypass -File ./setup-and-run.ps1",
    "build": "tsc --noEmit && vite build"
  },
